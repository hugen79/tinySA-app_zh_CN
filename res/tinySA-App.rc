// Icon + version info (unsigned exes without these attract antivirus false positives).
#include <winver.h>
#ifndef APP_VERSION  // set by CMakeLists.txt from git: "2.0.0-<commits>-g<hash>", 2,0,0,<commits>
#define APP_VERSION "2.0.0"
#define APP_VERSION_NUMBERS 2,0,0,0
#endif

IDI_ICON1 ICON "tinySA-App.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUMBERS
 PRODUCTVERSION APP_VERSION_NUMBERS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "tinySA-App spectrum analyser PC software"
            VALUE "FileVersion", "2.0.0"
            VALUE "InternalName", "tinySA-App"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "tinySA-App.exe"
            VALUE "ProductName", "tinySA-App"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
